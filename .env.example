# Copy to .env and fill in secrets (never commit .env)
OPENROUTER_API_KEY=sk-or-your-key-here
LLM_MIN_INTERVAL_SEC=5.0
DEEPSEEK_API_KEY=sk-your-key-here
# Floating AI assistant backend: HMAC secret shared by the dashboard + API
# server. Leave blank to auto-generate and persist it in the database.
SKOPOS_AGENT_TOKEN_SECRET=
# Override the assistant API base (default: same origin /agent). Use only for
# split-host dev, e.g. http://localhost:8502 when running outside nginx.
SKOPOS_AGENT_API_BASE=
# Dashboard password (optional). Two ways to set it:
#   1. Admin panel / setup modal → stores only a salted PBKDF2 hash in the DB
#      (recommended; plaintext never touches disk, supersedes this env var).
#   2. This env var (bootstrap / IaC) → plaintext, legacy.
# Leave empty to be prompted by the in-app "Secure your dashboard" modal.
SKOPOS_DASHBOARD_PASSWORD=
# Minimum length for new passwords (default 12)
SKOPOS_DASHBOARD_PASSWORD_MIN_LENGTH=12
# Auto sign-out after N hours (default 12)
SKOPOS_DASHBOARD_SESSION_HOURS=12
# Password rotation: warn/expire after N days (default 90; 0 disables reminders).
# When expired/expiring, a Telegram alert is sent if notifications are enabled.
SKOPOS_DASHBOARD_PASSWORD_MAX_AGE_DAYS=90
# Warn this many days before expiry (default 7)
SKOPOS_DASHBOARD_PASSWORD_WARN_DAYS=7
SKOPOS_SSH_KEY_PASSPHRASE=
# Production database (PostgreSQL). When set, SQLite db_path is ignored.
# SKOPOS_DATABASE_URL=postgresql://skopos:secret@localhost:5432/skopos
SKOPOS_SSH_STRICT_HOST_KEYS=1
TELEGRAM_BOT_TOKEN=

# GeoIP — default: free HTTP (geojs.io + ipwho.is), no signup required.
# Optional offline boost: MaxMind GeoLite2-Country (scripts/install_geolite2_country.sh)
# MAXMIND_LICENSE_KEY=
# MAXMIND_ACCOUNT_ID=
# SKOPOS_GEOIP_API_FALLBACK=0   # offline-only when MMDB file exists; ignored without MMDB

# --- AIMarket economy (optional; SKOPOS works fully without these) ---
# SKOPOS_AIMARKET_ENABLED=0
# SKOPOS_AIMARKET_PUBLIC_URL=https://skopos.modelmarket.dev
# SKOPOS_AIMARKET_PRODUCT_ID=prod-skopos
# SKOPOS_AIMARKET_API_KEY=
# SKOPOS_HUB_URL=https://modelmarket.dev
# SKOPOS_AIMARKET_AUTO_REGISTER=0
# SKOPOS_AIMARKET_PUBLISH_TOKEN=
# Persistent Ed25519 identity for /.well-known + signed manifests (Hub crawl).
# Default path is .skopos/aimarket_signing_key (compose volume on prod).
# SKOPOS_SIGNING_KEY_PATH=.skopos/aimarket_signing_key
# SKOPOS_SIGNING_SEED_B64=

# --- Host agents ------------------------------------------------------------
# Node secrets are HMAC keys, so SKOPOS must be able to read them back. With this
# set they are sealed with AES-GCM under a key held outside the database, so a
# leaked dump is not a set of working fleet credentials. Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
SKOPOS_NODE_SECRET_KEY=
